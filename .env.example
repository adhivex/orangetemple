# OrangeTemple environment variables. Names only — never commit values.
# Copy to .env.local for development. See CLAUDE.md for what each one is for.

# Database — Phase 2. Local Docker Postgres in development; Neon later.
DATABASE_URL=                        # pooled connection (runtime)
DIRECT_URL=                          # direct connection (migrations); on Vercel the Neon
                                     # integration provides DATABASE_URL_UNPOOLED instead (D-042)

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # https://orangetemple.in in production
NEXT_PUBLIC_CONTACT_EMAIL=                   # corrections and contact (open item #4)

# Images — Phase 3
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=                  # upload scripts only, server-side
CLOUDINARY_API_SECRET=               # upload scripts only, server-side

# Maps — Phase 6 (open item #6)
NEXT_PUBLIC_MAPBOX_TOKEN=            # public, URL-restricted token

# Revalidation — Phase 2+
REVALIDATE_SECRET=

# Seeding — development | preview | production (D-020)
SEED_TARGET=development
