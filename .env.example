# OrangeTemple environment variables. Names only — never commit values.
# Copy to .env.local for development. See CLAUDE.md for what each one is for.

# Supabase (D-043). Locally, `supabase start` prints these; on Vercel the Supabase
# integration provides them. The secret key is for the seed and upload scripts only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=            # server-side reads; Row Level Security applies
SUPABASE_SECRET_KEY=                 # seed and image uploads only; never in the browser or Git
POSTGRES_URL_NON_POOLING=            # session connection for migrations (`pnpm db:deploy`)
SUPABASE_DB_URL=                     # optional override for migrations: the Session pooler URL,
                                     # if the build cannot reach POSTGRES_URL_NON_POOLING (IPv6)

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # https://orangetemple.in in production
NEXT_PUBLIC_CONTACT_EMAIL=                   # corrections and contact (open item #4)

# Images — Phase 3 (Cloudinary; moving to Supabase Storage, D-043)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=                  # upload scripts only, server-side
CLOUDINARY_API_SECRET=               # upload scripts only, server-side

# Maps — Phase 6 (open item #6)
NEXT_PUBLIC_MAPBOX_TOKEN=            # public, URL-restricted token

# Revalidation — Phase 2+
REVALIDATE_SECRET=

# Seeding — development | preview | production (D-020)
SEED_TARGET=development
